# ====================================================================
# SafeHer — Environment Configuration Template
# "Travel Freely. Stay Safely."
# ====================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=safeher-super-secret-jwt-key-2026-production-ready

# --------------------------------------------------------------------
# 1. Google Gemini API (AI Travel Safety Assistant)
# Where to obtain:
# Visit https://aistudio.google.com/app/apikey to generate a free Gemini API key.
# Note: If left blank or default, SafeHer automatically runs with its built-in
# offline safety guidance engine so all chat interactions remain functional.
# --------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --------------------------------------------------------------------
# 2. Supabase / PostgreSQL Database & Auth
# Where to obtain:
# Visit https://supabase.com -> Create Project -> Project Settings -> API.
# Note: If left blank, SafeHer automatically runs on its built-in hybrid
# resilient store seeded with demo travellers, guardians, and safe places.
# --------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

